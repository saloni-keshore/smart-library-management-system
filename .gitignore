# Python bytecode / cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Test coverage
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
# Real per-environment env files (local .env.test, etc.); templates are committed.
.env.*
!.env.example
!.env.test.example

# SQLite data is operational data; keep it out of source control.
database/*.db
*.db-journal
*.db-wal
*.db-shm

# Manual backup exports (Settings -> Data & Backup) are operational data too.
backups/*.db
backups/*.json
instance/

# Runtime uploads can contain customer-provided documents.
static/uploads/settings/*
!static/uploads/settings/.gitkeep

# OS cruft
.DS_Store
Thumbs.db

# Editor/IDE
.idea/
.vscode/
