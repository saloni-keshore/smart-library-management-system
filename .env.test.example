# Copy to `.env.test` (git-ignored) to run the pytest suite against a
# DEDICATED throwaway Supabase project - never the project the local app and
# the Vercel deployment share. tests/conftest.py loads this file with
# override=True before app/config import, so these values win over `.env`.
#
# The test project must have the full schema applied
# (database/supabase_migration.sql, run once in its SQL Editor); verify with
#   python scripts/verify_schema.py      # with .env.test values in the env
APP_ENV=development
SECRET_KEY=test-secret-key
SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-the-test-project-service-role-key
