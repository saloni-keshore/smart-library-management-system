# Required in production: generate with `secrets.token_urlsafe(32)`.
SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=production
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_MINUTES=60
LOG_LEVEL=INFO
# Required: Supabase is the only datastore (ADR-32).
SUPABASE_URL=https://your-project.supabase.co
# Service-role key: used ONLY by offline scripts/tooling
# (get_service_role_client() in database/supabase_client.py) - never by
# per-request app traffic as of ADR-75, since it bypasses Row-Level
# Security entirely.
SUPABASE_SECRET_KEY=replace-with-your-supabase-service-role-key
# Anon/publishable key: used for every per-request app client (tenant-
# scoped or pre-login), so Row-Level Security actually applies (ADR-75).
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
# JWT secret (Project Settings -> API -> JWT Settings): used to sign the
# short-lived, per-request tenant JWT that RLS policies check via
# current_admin_id() (ADR-75). Never expose this value to a client.
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret
# Optional: Storage bucket for Library Profile logo/stamp/signature images
# (ADR-57). Auto-created on first upload; only set this to override the name.
# SUPABASE_STORAGE_BUCKET=library-branding
